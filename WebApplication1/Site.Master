<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WebApplication1.SiteMaster" %>


<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - My ASP.NET Application</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark"><!-- <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark"> -->
            <div class="container">
                <a class="navbar-brand" runat="server" href="~/">Home</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                  <!--  <ul class="navbar-nav flex-grow-1">
                      
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About">About</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contact</a></li>
                        <li class="nav-item"> 
                            <asp:Menu ID="Menu1" class="nav-link" runat="server" Orientation="Horizontal" Visible="False">
                                <Items>
                                    <asp:MenuItem NavigateUrl="~/Private/Private1.aspx" Text="Prescription" Value="Dashboard"></asp:MenuItem>
                                    <asp:MenuItem NavigateUrl="~/Private/Private2.aspx" Text="Dashboard" Value="Details"></asp:MenuItem>
                                </Items>
                            </asp:Menu>
                    </ul> -->


<ul class="navbar-nav flex-grow-1">

    <!-- Public navigation -->
    <li class="nav-item">
        <a class="nav-link" runat="server" href="~/About">About</a>
    </li>

    <li class="nav-item">
        <a class="nav-link" runat="server" href="~/Contact">Contact</a>
    </li>


    <!-- PATIENT NAVIGATION -->
    <li id="patientDashboardNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
           href="~/Private/Patient/PatientDashboard.aspx">
            Patient Dashboard
        </a>
    </li>
    <li id="appointmentView">
                <a class="nav-link" runat="server"
   href="~/Private/Appointments/Appointments.aspx">
    Appointment View
</a>
    </li>


    <!-- NURSE NAVIGATION -->
    <li id="nurseDashboardNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Nurse/WebForm1.aspx">
            Nurse Dashboard
        </a>
    </li>

    <li id="nurseMedicationNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Nurse/MedicationAdministration.aspx">
            Medication Administration
        </a>
    </li>

    <li id="nurseProfileNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Nurse/Profile.aspx">
            Profile
        </a>
    </li>


    <!-- DOCTOR NAVIGATION -->
    <li id="doctorDashboardNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Doctor/WebForm1.aspx">
            Doctor Dashboard
        </a>
    </li>

    <li id="doctorPrescriptionNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Doctor/Prescription.aspx">
            Prescription
        </a>
    </li>

    <li id="doctorProfileNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Doctor/Profile.aspx">
            Profile
        </a>
    </li>


    <!-- ADMINISTRATOR NAVIGATION -->
    <li id="adminDashboardNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Administrator/WebForm1.aspx">
            Admin Dashboard
        </a>
    </li>

    <li id="adminMedicineNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Administrator/MedicineManagement.aspx">
            Medicine Management
        </a>
    </li>

    <li id="adminManageStaffNav" runat="server" visible="false" class="nav-item">
        <a class="nav-link" runat="server"
            href="~/Private/Administrator/ManageStaff.aspx">
            Manage Staff
        </a>
    </li>

</ul>


                    <asp:LoginView runat="server" ViewStateMode="Disabled">
                        <AnonymousTemplate>
                            <ul class="navbar-nav navbar-right">
                                <li><a runat="server" class="nav-link" href="~/Account/Register">Register</a></li>
                                <li><a runat="server" class="nav-link" href="~/Account/Login">Log in</a></li>
                            </ul>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                            <ul class="navbar-nav navbar-right">
                                <li><a runat="server" class="nav-link" href="~/Account/Manage" title="Manage your account">Hello, <%: Context.User.Identity.GetUserName()  %> !</a></li>
                                <li>
                                    <asp:LoginStatus runat="server" CssClass="nav-link" LogoutAction="Redirect" LogoutText="Log off" LogoutPageUrl="~/" OnLoggingOut="Unnamed_LoggingOut" />
                                </li>
                            </ul>
                        </LoggedInTemplate>
                    </asp:LoginView>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - My Major Project</p>
            </footer>
        </div>

    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder></body>
</html>
